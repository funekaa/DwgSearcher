<Window x:Class="DwgSearcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DwgSearcher" 
        Icon="/app.ico"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. 顶部搜索与工具栏 -->
            <RowDefinition Height="Auto" />
            <!-- 2. 主体左右分栏内容 -->
            <RowDefinition Height="*" />
            <!-- 3. 底部状态栏 -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ================= 1. 顶部搜索与工具栏 ================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 应用品牌徽标 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 搜索输入区 -->
                    <ColumnDefinition Width="*" />
                    <!-- 右侧操作栏 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用品牌名称与精美图标及版本号 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image Source="/app.png" Width="28" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DwgSearcher" FontSize="18" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" />
                    <Border Background="#EBF3FC" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppVersionTextBlock" Text="v1.0.11" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4" />
                    </Border>
                </StackPanel>

                <!-- 搜索输入框容器 -->
                <Grid Grid.Column="1" Margin="0,0,15,0">
                    <Border Background="#F9F9F9" BorderBrush="#D1D1D1" BorderThickness="1.5" CornerRadius="6">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 放大镜图标 -->
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#888888" />

                            <!-- 搜索文本框 -->
                            <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="15" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="2,8"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />

                            <!-- 占位水印提示 -->
                            <TextBlock x:Name="WatermarkTextBlock" Grid.Column="1" Text="输入图号、设计者、文字、标注尺寸、属性等关键词检索..." 
                                       FontSize="13.5" Foreground="#9E9E9E" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 清空按钮 -->
                            <Button x:Name="ClearButton" Grid.Column="2" Content="✕" FontSize="12" Foreground="#888888" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2"
                                    Click="ClearButton_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 顶部右侧快捷按钮栏 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSyncIndex" Content="🔄 增量更新" Style="{StaticResource SecondaryButton}" Click="SyncIndex_Click" Margin="0,0,8,0" />
                    <Button x:Name="BtnSettings" Content="⚙ 目录设置" Style="{StaticResource ModernButton}" Click="OpenSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. 主体工作区（左右分栏） ================= -->
        <Grid Grid.Row="1" Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <!-- 左侧：搜索文件列表 -->
                <ColumnDefinition Width="480" MinWidth="320" />
                <!-- 分割条 -->
                <ColumnDefinition Width="8" />
                <!-- 右侧：文本上下文 + 图纸预览 -->
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左侧卡片：文件结果列表 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 结果统计头 -->
                    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="8,8,0,0">
                        <TextBlock x:Name="ResultSummaryTextBlock" Text="等待输入检索..." FontSize="12.5" FontWeight="SemiBold" Foreground="#555555" />
                    </Border>

                    <!-- 文件列表 -->
                    <ListView x:Name="ResultsListView" Grid.Row="1" BorderThickness="0" Background="Transparent"
                              SelectionChanged="ResultsListView_SelectionChanged" MouseDoubleClick="ResultsListView_MouseDoubleClick">
                        <!-- 右键菜单 -->
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuOpenFile" Header="📂 打开图纸文件" Click="MenuOpenFile_Click" FontWeight="Bold" />
                                <MenuItem x:Name="MenuOpenFolder" Header="📁 打开所在文件夹" Click="MenuOpenFolder_Click" />
                                <Separator />
                                <MenuItem x:Name="MenuCopyPath" Header="📋 复制文件完整路径" Click="MenuCopyPath_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Windows 系统原生识别的 DWG/DXF 文件图标 -->
                                        <Image Grid.Column="0" Source="{Binding FileIcon}" Width="30" Height="30" 
                                               VerticalAlignment="Center" Margin="0,0,10,0" 
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- 文件详细信息 -->
                                        <StackPanel Grid.Column="1">
                                            <!-- 文件名 -->
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#0066CC" TextTrimming="CharacterEllipsis" />
                                            
                                            <!-- 上下文摘要 -->
                                            <TextBlock Text="{Binding Snippet}" FontSize="12" Foreground="#444444" Margin="0,3,0,4" 
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                            
                                            <!-- 文件路径与大小信息 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FilePath}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" FontSize="11" Foreground="#888888" Margin="8,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyStateTextBlock" Grid.Row="1" Text="未找到匹配的 CAD 图纸内容" 
                               FontSize="14" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 左右分割拖动条 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE" />

            <!-- 右侧卡片：文本详情 + 预览图像 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- 上部：命中内容与全部提取文本 -->
                    <RowDefinition Height="*" MinHeight="180" />
                    <!-- 上下分割条 -->
                    <RowDefinition Height="8" />
                    <!-- 下部：图纸缩略图与图元信息 -->
                    <RowDefinition Height="280" MinHeight="150" />
                </Grid.RowDefinitions>

                <!-- 1. 文本内容详情面板 -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 面板标题 -->
                        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PanelExtractedTextTitle" Grid.Column="0" Text="📝 图纸提取文本与上下文 (高亮匹配)" FontSize="12.5" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" />
                                <Button x:Name="BtnCopyText" Grid.Column="1" Content="📋 复制全文" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11.5" Click="CopyText_Click" />
                            </Grid>
                        </Border>

                        <!-- 富文本高亮展示区 -->
                        <RichTextBox x:Name="ContentRichTextBox" Grid.Row="1" BorderThickness="0" Padding="12" 
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" 
                                     FontFamily="Consolas, Microsoft YaHei" FontSize="13" />
                    </Grid>
                </Border>

                <!-- 上下分割拖动条 -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />

                <!-- 2. 图纸缩略图与图形预览面板 (Windows Explorer 原生缩略图) -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 面板标题 -->
                        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PanelPreviewTitle" Grid.Column="0" Text="🖼 图纸资源管理器 (Explorer) 高清缩略图预览" FontSize="12.5" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" />
                                <Button x:Name="BtnOpenCurrent" Grid.Column="1" Content="🚀 打开图纸" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11.5" Click="OpenCurrentFile_Click" />
                            </Grid>
                        </Border>

                        <!-- 图像预览呈现区域 -->
                        <Grid Grid.Row="1" Margin="10" Background="#1E1E1E">
                            <!-- Explorer 缩略图图像 -->
                            <Image x:Name="ThumbnailImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- 无预览图时的占位提示 -->
                            <StackPanel x:Name="NoPreviewPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="📐" FontSize="36" HorizontalAlignment="Center" Foreground="#666666" Margin="0,0,0,6" />
                                <TextBlock x:Name="NoPreviewTextBlock" Text="该 DWG/DXF 文件未生成资源管理器位图缩略图" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NoPreviewSubTextBlock" Text="可直接双击左侧列表使用 CAD 软件查看完整图形" FontSize="11" Foreground="#666666" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 3. 底部状态栏 ================= -->
        <Border Grid.Row="2" Background="#EAEAEA" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="就绪" FontSize="11.5" Foreground="#555555" />
                <TextBlock x:Name="DbInfoTextBlock" Grid.Column="1" Text="DwgSearcher (SQLite FTS5 + WAL 引擎)" FontSize="11.5" Foreground="#777777" />
            </Grid>
        </Border>
    </Grid>
</Window>
