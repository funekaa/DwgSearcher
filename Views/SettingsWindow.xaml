<Window x:Class="DwgSearcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - DwgSearcher" 
        Icon="/app.ico"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与右上角更新链接 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleTextBlock" Grid.Column="0" Text="图纸索引目录管理" FontSize="17" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                <Hyperlink x:Name="UpdateHyperlink" Click="UpdateHyperlink_Click" Foreground="#0066CC" TextDecorations="None" Cursor="Hand">
                    <Run x:Name="UpdateLinkRun" Text="🔗 更新链接" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- 目录列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="2">
            <DataGrid x:Name="FoldersDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColFolderPath" Header="监控文件夹路径" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                    <DataGridCheckBoxColumn x:Name="ColIncludeSub" Header="包含子文件夹" Binding="{Binding IncludeSubdirectories}" Width="110" />
                    <DataGridTemplateColumn x:Name="ColAction" Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding RemoveButtonText}" Style="{StaticResource SecondaryButton}" 
                                        Padding="8,2" FontSize="12" Click="RemoveFolder_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 添加目录操作栏与重建进度指示 -->
        <Grid Grid.Row="2" Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnAddFolder" Content="➕ 添加图纸文件夹..." Style="{StaticResource ModernButton}" Click="AddFolder_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnRebuildIndex" Content="🔄 立即全量重建索引" Style="{StaticResource SecondaryButton}" Click="RebuildIndex_Click" />
            </StackPanel>
            <StackPanel x:Name="RebuildProgressPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar x:Name="RebuildProgressBar" Width="120" Height="10" Minimum="0" Maximum="100" 
                             Foreground="#0078D4" Background="#E0E0E0" BorderThickness="0" Margin="0,0,8,0" />
                <TextBlock x:Name="RebuildProgressText" Text="0%" FontSize="11.5" Foreground="#0078D4" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- 选项设置 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="AutoSyncCheckBox" Content="开启后台实时监听 (当 CAD 图纸新建/修改/保存时自动更新索引)" 
                          FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="SettingsNoteTextBlock" Text="说明：系统支持 .dwg 与 .dxf 格式，自动深度解析图纸标题栏、属性定义、标注、文字及表格数据。" 
                           FontSize="12" Foreground="#777777" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 多语言选择区域 -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LanguageLabelTextBlock" Grid.Column="0" Text="🌐 界面多语言选项 (Language):" 
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#333333" />
                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                          Height="30" VerticalContentAlignment="Center" FontSize="13"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                          SelectionChanged="LanguageComboBox_SelectionChanged" />
            </Grid>
        </Border>

        <!-- 底部确定按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="保存并应用" Style="{StaticResource ModernButton}" MinWidth="110" Padding="14,4" Click="Save_Click" Margin="0,0,10,0" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="85" Padding="12,4" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
